🎯 Goal:
We will create an EC2 instance inside an already existing VPC and subnet, using the latest Amazon Linux 2 AMI dynamically fetched via data sources.

🧩 Project Structure
terraform-project/
├── main.tf
├── variables.tf
├── outputs.tf
🪶 Step 1: main.tf
# ---------- Provider Configuration ----------
provider "aws" {
  region = var.aws_region
}

# ---------- Data Sources ----------
# 1. Fetch existing VPC
data "aws_vpc" "existing_vpc" {
  filter {
    name   = "tag:Name"
    values = ["production-vpc"]
  }
}

# 2. Fetch existing Subnet in that VPC
data "aws_subnet" "existing_subnet" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.existing_vpc.id]
  }

  filter {
    name   = "tag:Name"
    values = ["public-subnet-1"]
  }
}

# 3. Fetch latest Amazon Linux 2 AMI
data "aws_ami" "amazon_linux" {
  most_recent = true
  filter {
    name   = "name"
    values = ["amzn2-ami-hvm-*-x86_64-gp2"]
  }
  owners = ["amazon"]
}

# ---------- Create EC2 Instance ----------
resource "aws_instance" "web_server" {
  ami           = data.aws_ami.amazon_linux.id
  instance_type = "t2.micro"
  subnet_id     = data.aws_subnet.existing_subnet.id

  tags = {
    Name = "WebServer-From-Terraform"
    Environment = "Production"
  }
}

🪶 Step 2: variables.tf
variable "aws_region" {
  description = "AWS region to deploy resources"
  type        = string
  default     = "ap-south-1"
}
🪶 Step 3: outputs.tf
output "vpc_id" {
  value = data.aws_vpc.existing_vpc.id
}

output "subnet_id" {
  value = data.aws_subnet.existing_subnet.id
}

output "ami_id" {
  value = data.aws_ami.amazon_linux.id
}

output "instance_public_ip" {
  value = aws_instance.web_server.public_ip
}
🔍 What’s Happening Here (Step-by-Step)
Step	Terraform Component	Purpose
1	data "aws_vpc"	Reads an existing VPC (not creating new one).
2	data "aws_subnet"	Reads an existing subnet inside that VPC.
3	data "aws_ami"	Fetches latest Amazon Linux 2 AMI ID dynamically.
4	aws_instance	Creates a new EC2 instance using data from above data sources.
